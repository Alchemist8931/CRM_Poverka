{
  "name": "uchetkin-web",
  "version": "0.1.0",
  "private": true,
  "description": "CRM «Учёткин» — фронт: экраны прототипа на модулях, сборка Vite, работа через API и демо-режим",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "build:all": "npm run build && npm run build:demo && node scripts/publish-demo.mjs",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs",
    "e2e": "node scripts/e2e.mjs",
    "check:photo-ui": "node scripts/check-photo-ui.mjs",
    "check:audit-ui": "node scripts/check-audit-ui.mjs",
    "check:notify-ui": "node scripts/check-notify-ui.mjs",
    "check:maps-ui": "node scripts/check-maps-ui.mjs",
    "check:print-ui": "node scripts/check-print-ui.mjs",
    "check:payment-ui": "node scripts/check-payment-ui.mjs"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.56.1",
    "pngjs": "^7.0.0",
    "vite": "^7.1.14",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
