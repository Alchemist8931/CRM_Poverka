#cloud-config
# Первичная настройка ВМ CRM «Учёткин». Файл собирается Terraform: всё, что
# зависит от контура и от доменного имени, приходит переменными, а не правится руками.
timezone: ${timezone}

package_update: true
package_upgrade: true

packages:
  - docker.io
  - docker-compose-v2
  - jq
  - curl
  - ca-certificates
  - unattended-upgrades
  - chrony

users:
  - name: ${vm_user}
    gecos: Сервисный пользователь CRM «Учёткин»
    groups: [docker, sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true

write_files:
  # ── Конфигурация приложения. Секретов здесь нет: только адреса и идентификаторы
  #    секретов в Lockbox, которые приложение читает при старте по сервисному аккаунту.
  - path: /etc/uchetkin/app.env
    permissions: "0640"
    owner: root:root
    content: |
      APP_ENV=${env}
      TZ=${timezone}
      APP_DOMAIN=${app_domain}
      PUBLIC_BASE_URL=${public_base_url}
      API_BASE_URL=${api_base_url}
      WEBHOOK_BASE_URL=${webhook_base_url}
      COOKIE_DOMAIN=${cookie_domain}
      API_PATH_PREFIX=${api_path_prefix}
      HEALTH_PATH=${health_check_path}
      TLS_BY_CADDY=${tls_by_caddy}
      YC_FOLDER_ID=${folder_id}
      S3_ENDPOINT=https://storage.yandexcloud.net
      ACTS_BUCKET=${acts_bucket}
      CALLS_BUCKET=${calls_bucket}
      MANAGED_POSTGRES=${managed_postgres}
      PGHOST=${pg_host}
      PGPORT=${pg_port}
      PGDATABASE=${pg_database}
      PGUSER=${pg_user}
%{ if managed_postgres ~}
      # Managed PostgreSQL принимает только TLS; сертификат кластера подписан
      # корневым сертификатом облака, который лежит в образе API
      # (server/certs/yandex-cloud-ca.pem). Строку подключения с этими
      # параметрами собирает server/src/secrets.ts.
      PGSSLMODE=verify-full
      PGSSLROOTCERT=/app/certs/yandex-cloud-ca.pem
%{ endif ~}
      LOCKBOX_DB_SECRET_ID=${lockbox_db_secret_id}
      LOCKBOX_APP_SECRET_ID=${lockbox_app_secret_id}
      LOCKBOX_STORAGE_SECRET_ID=${lockbox_storage_secret_id}
      # Эксплуатация (пункт cloud-ops): куда машина кладёт резервные копии
      # и куда агент отправляет журналы. Читают их таймеры uchetkin-backup
      # и uchetkin-status, а не приложение.
      OPS_BUCKET=${ops_bucket}
      LOG_GROUP_ID=${log_group_id}
      # Правила входа и журналирования в самом приложении. Значения приходят из
      # Terraform (переменная app_auth_policy), а не зашиты в код: пункт 152-ФЗ
      # проверяется по конфигурации контура, а не по чтению исходников.
      # Реализует их сервер — пункты плана be-api и be-audit.
      AUTH_PASSWORD_MIN_LENGTH=${auth.password_min_length}
      AUTH_PASSWORD_CLASSES=${auth.password_classes}
      AUTH_PASSWORD_MAX_AGE_DAYS=${auth.password_max_age_days}
      AUTH_MAX_FAILED_ATTEMPTS=${auth.max_failed_attempts}
      AUTH_LOCKOUT_MINUTES=${auth.lockout_minutes}
      SESSION_IDLE_MINUTES=${auth.session_idle_minutes}
      SESSION_ABSOLUTE_HOURS=${auth.session_absolute_hours}
      AUDIT_RETAIN_DAYS=${auth.audit_retain_days}
%{ for name, id in lockbox_external_secrets ~}
      LOCKBOX_${upper(name)}_SECRET_ID=${id}
%{ endfor ~}

  # ── То же самое для собранного фронта: адрес API отдаётся ему файлом,
  #    а не зашивается в сборку. Переезд на боевой домен фронт не пересобирает.
  - path: /opt/uchetkin/config/frontend.json
    permissions: "0644"
    owner: root:root
    content: |
      {
        "env": "${env}",
        "apiBaseUrl": "${api_base_url}",
        "publicBaseUrl": "${public_base_url}",
        "healthPath": "${health_check_path}"
      }

  # ── Домен для Caddy. Caddy сам получает и продлевает сертификат Let's Encrypt.
  - path: /etc/uchetkin/caddy.env
    permissions: "0644"
    owner: root:root
    content: |
      SITE_ADDRESS=${tls_by_caddy ? app_domain : ":80"}
      API_UPSTREAM=api:3000

  # ── Редирект со старых адресов после переезда на боевой домен (cloud-domain).
  #    Caddyfile подхватывает всё из /etc/uchetkin/caddy.d/*.caddy; файл есть
  #    всегда, чтобы состояние машины не зависело от того, был ли список пуст.
  - path: /etc/uchetkin/caddy.d/legacy.caddy
    permissions: "0644"
    owner: root:root
    content: |
      # Собирается Terraform из legacy_redirect_from — руками не править.
      %{~ if length(legacy_redirect_from) > 0 ~}
      ${join(", ", legacy_redirect_from)} {
      	redir https://${app_domain}{uri} permanent
      }
      %{~ else ~}
      # Старых адресов нет: список legacy_redirect_from пуст.
      %{~ endif ~}

  # ── Вход на машину: только по ключу и только этим пользователем.
  #    Файл кладётся в sshd_config.d — его подхватывает Include из штатного
  #    конфигурации Ubuntu, а сам конфигурации не правится: так настройка
  #    переживает обновление пакета openssh-server.
  - path: /etc/ssh/sshd_config.d/10-uchetkin.conf
    permissions: "0644"
    owner: root:root
    content: |
      # Пароли выключены полностью: ни пользователю, ни root.
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitEmptyPasswords no
      PermitRootLogin no
%{ if enable_oslogin ~}
      # Вход идёт через OS Login: список пользователей и их ключи ведёт облако,
      # поэтому AllowUsers здесь не задаётся — иначе он перекроет права из IAM.
%{ else ~}
      AuthenticationMethods publickey
      AllowUsers ${vm_user}
%{ endif ~}
      MaxAuthTries 3
      LoginGraceTime 30
      X11Forwarding no
      AllowAgentForwarding no
      # Забытая открытой сессия закрывается сама через десять минут молчания.
      ClientAliveInterval 300
      ClientAliveCountMax 2

  # ── Ротация журналов Docker: иначе они съедают диск ВМ.
  - path: /etc/docker/daemon.json
    permissions: "0644"
    owner: root:root
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "50m", "max-file": "5" }
      }

  # ── Агент мониторинга. Метрики уходят в Cloud Monitoring, авторизация —
  #    по сервисному аккаунту ВМ через метаданные, без ключей на диске.
  - path: /etc/uchetkin/unified-agent.yml
    permissions: "0644"
    owner: root:root
    content: |
      status:
        port: 16241
      storages:
        - name: main
          plugin: fs
          config:
            directory: /var/lib/yandex/unified_agent/main
            max_partition_size: 100mb
        # Своё хранилище для журналов: одно хранилище агент разрешает
        # подключить только к одному каналу.
        - name: logs
          plugin: fs
          config:
            directory: /var/lib/yandex/unified_agent/logs
            max_partition_size: 200mb
      channels:
        - name: cloud_monitoring
          channel:
            pipe:
              - storage_ref:
                  name: main
            output:
              plugin: yc_metrics
              config:
                folder_id: ${folder_id}
                iam:
                  cloud_meta: {}
      routes:
        - input:
            plugin: linux_metrics
            config:
              namespace: sys
          channel:
            channel_ref:
              name: cloud_monitoring

        # Метрики Caddy (запросы, коды ответов, время ответа): Caddy отдаёт
        # их в формате Prometheus на 127.0.0.1:${caddy_metrics_port}
        # (deploy/Caddyfile, deploy/compose.yml). По ним доска HTTP и
        # тревога «много 5xx» у сторожа.
        - input:
            plugin: metrics_pull
            config:
              url: http://127.0.0.1:${caddy_metrics_port}/metrics
              format:
                prometheus: {}
              poll_period: 30s
          channel:
            channel_ref:
              name: cloud_monitoring

        # Журналы контейнеров — в Cloud Logging (infra/logging.tf). Docker пишет
        # каждую строку как JSON с полями log, stream, time; агент берёт из них
        # текст и время. Хранение — logs_retention_days.
        - input:
            plugin: file_input
            config:
              path: /var/lib/docker/containers/*/*-json.log
              multi_file: true
              state_directory: /var/lib/yandex/unified_agent/docker-logs
              file_format: text
          channel:
            pipe:
              - storage_ref:
                  name: logs
            output:
              plugin: yc_logs
              config:
                log_group_id: ${log_group_id}
                iam:
                  cloud_meta: {}
                resource_type: vm
                resource_id: ${vm_hostname}
                stream_name: docker
                parse_json:
                  payload:
                    keys: [log]
                  timestamp:
                    keys: [time]

  - path: /opt/uchetkin/compose.platform.yml
    permissions: "0644"
    owner: root:root
    content: |
      # Платформенная часть: она есть на ВМ с первого запуска и не зависит
      # от выкладки приложения. Сборка и обновление контейнеров api, worker и
      # caddy — пункт плана cloud-cicd.
      #
      # Своё имя проекта обязательно. Без него Compose берёт имя проекта из
      # имени каталога, то есть «uchetkin», — ровно то же, что стоит в
      # deploy/compose.yml. Тогда агент мониторинга оказывается для выкладки
      # чужим контейнером её же проекта, и `docker compose up -d
      # --remove-orphans` из deploy.sh сносит его при каждом релизе.
      # Проверено на живой машине 18.09.2026: агент был снесён именно так.
      name: uchetkin-platform

      services:
        unified-agent:
          image: ${monitoring_agent_image}
          container_name: unified-agent
          restart: always
          network_mode: host
          pid: host
          privileged: true
          environment:
            - FOLDER_ID=${folder_id}
          volumes:
            # Своя конфигурация подкладывается образу как шаблон, а не как
            # готовый config.yml. Точка входа образа делает ровно одно:
            #   eval echo "$(cat config.tmpl.yml)" > config.yml
            # и затем запускает агент с config.yml. Поэтому монтировать нашу
            # конфигурацию на config.yml нельзя: под :ro точка входа падает с
            # «cannot create config.yml: Read-only file system» и контейнер
            # уходит в вечный перезапуск, а без :ro она перезатирает нашу
            # конфигурацию своим шаблоном. Проверено на живой машине 18.09.2026.
            - /etc/uchetkin/unified-agent.yml:/etc/yandex/unified_agent/config.tmpl.yml:ro
            - /var/lib/yandex/unified_agent:/var/lib/yandex/unified_agent
            - /proc:/ua_proc:ro
            # Журналы контейнеров для Cloud Logging — только чтение.
            - /var/lib/docker/containers:/var/lib/docker/containers:ro

  # ── Резервная копия базы: pg_dump в бакет ops (infra/backup.tf).
  #    Ежедневно в pg/daily/, по воскресеньям ещё и в pg/weekly/. Без ключей на
  #    диске — по IAM-токену сервисного аккаунта машины (роль storage.uploader
  #    на бакет). Отметка последней удачной копии — в /var/lib/uchetkin, по ней
  #    uchetkin-status отдаёт метрику возраста, а сторож поднимает тревогу.
  #    Как восстановить и сколько это занимает — docs/ops.md.
  - path: /usr/local/bin/uchetkin-backup
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      # Резервная копия базы CRM «Учёткин» → Object Storage. Запускает таймер
      # uchetkin-backup.timer; руками: sudo systemctl start uchetkin-backup.
      set -euo pipefail
      . /etc/uchetkin/app.env
      : "$${OPS_BUCKET:?в app.env нет OPS_BUCKET}"
      STATE_DIR=/var/lib/uchetkin
      WORK=/var/lib/uchetkin/backup
      mkdir -p "$STATE_DIR" "$WORK"
      DAY=$(date +%F)
      FILE="$WORK/$PGDATABASE-$DAY.dump"
      META=http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token
      LOCKBOX=https://payload.lockbox.api.cloud.yandex.net/lockbox/v1/secrets

      echo "дамп $PGDATABASE ($DAY)"
      if [ "$${MANAGED_POSTGRES:-true}" = "true" ]; then
        # Кластер Managed PostgreSQL: пароль из Lockbox. Порт — 6432, пул
        # соединений: прямой 5432 у Managed PostgreSQL снаружи закрыт
        # (проверено на учениях cloud-ops), pg_dump через пул работает.
        TOKEN=$(curl -sfH 'Metadata-Flavor: Google' "$META" | jq -re .access_token)
        PGPASSWORD=$(curl -sfH "Authorization: Bearer $TOKEN" "$LOCKBOX/$LOCKBOX_DB_SECRET_ID/payload" \
          | jq -re '.entries[] | select(.key == "password") | .textValue')
        export PGPASSWORD
        docker run --rm -e PGPASSWORD postgres:16-alpine \
          pg_dump -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -Fc "$PGDATABASE" > "$FILE"
      else
        # База контейнером (dev): дамп изнутри контейнера, пароль не нужен.
        docker exec uchetkin-postgres pg_dump -U "$PGUSER" -Fc "$PGDATABASE" > "$FILE"
      fi
      SIZE=$(stat -c %s "$FILE")
      [ "$SIZE" -gt 1024 ] || { echo "дамп подозрительно мал: $SIZE байт" >&2; exit 1; }

      TOKEN=$(curl -sfH 'Metadata-Flavor: Google' "$META" | jq -re .access_token)
      upload() {
        local key=$1 code
        # Ответ хранилища — в файл, а не в /dev/stderr: под systemd stderr — сокет
        # журнала, и curl на нём падает с кодом 23 ещё до проверки ответа.
        code=$(curl -s -o "$WORK/upload.out" -w '%%{http_code}' -X PUT \
          -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/octet-stream' \
          --upload-file "$FILE" "https://storage.yandexcloud.net/$OPS_BUCKET/$key" || echo "curl:$?")
        [ "$code" = 200 ] || { echo "загрузка $key: HTTP $code: $(head -c 300 "$WORK/upload.out")" >&2; return 1; }
        echo "→ s3://$OPS_BUCKET/$key ($SIZE байт)"
      }
      upload "pg/daily/$PGDATABASE-$DAY.dump"
      # Воскресенье — ещё и годовая копия.
      [ "$(date +%u)" = 7 ] && upload "pg/weekly/$PGDATABASE-$DAY.dump"

      date +%s > "$STATE_DIR/backup.last_ok"
      echo "$SIZE" > "$STATE_DIR/backup.last_size"
      # Локально держим только последний дамп: место на диске дороже.
      find "$WORK" -name '*.dump' ! -name "$(basename "$FILE")" -delete
      # Сразу обновить метрики, чтобы сторож увидел свежую копию.
      /usr/local/bin/uchetkin-status || true

  # ── Служебные метрики машины → Monitoring (service=custom, host=имя машины).
  #    Раз в status_interval_minutes минут; по ним доски (monitoring.tf) и
  #    тревоги сторожа (watchdog.tf): возраст копии, диск, сертификат.
  - path: /usr/local/bin/uchetkin-status
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      # Служебные метрики CRM «Учёткин». Запускает uchetkin-status.timer.
      set -euo pipefail
      . /etc/uchetkin/app.env
      HOST=$(hostname)
      META=http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token
      NOW=$(date +%s)

      LAST=$(cat /var/lib/uchetkin/backup.last_ok 2>/dev/null || echo 0)
      if [ "$LAST" -gt 0 ]; then BACKUP_AGE=$(( (NOW - LAST) / 3600 )); else BACKUP_AGE=9999; fi
      BACKUP_SIZE=$(cat /var/lib/uchetkin/backup.last_size 2>/dev/null || echo 0)
      DISK=$(df --output=pcent / | tail -1 | tr -dc '0-9')
      APP=$(curl -sf -m 5 http://127.0.0.1:3000/health >/dev/null && echo 1 || echo 0)
      RUNNING=$(docker ps -q | wc -l)

      # Дни до конца сертификата: −1, пока TLS выключен или сертификата нет.
      CERT_DAYS=-1
      if [ "$${TLS_BY_CADDY:-false}" = "true" ]; then
        END=$(echo | openssl s_client -connect 127.0.0.1:443 -servername "$APP_DOMAIN" 2>/dev/null \
          | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true)
        [ -n "$END" ] && CERT_DAYS=$(( ($(date -d "$END" +%s) - NOW) / 86400 ))
      fi

      metric() { printf '{"name":"%s","labels":{"host":"%s"},"value":%s}' "$1" "$HOST" "$2"; }
      BODY=$(printf '{"metrics":[%s,%s,%s,%s,%s,%s,%s]}' \
        "$(metric uchetkin.status_ok 1)" \
        "$(metric uchetkin.backup_age_hours "$BACKUP_AGE")" \
        "$(metric uchetkin.backup_size_bytes "$BACKUP_SIZE")" \
        "$(metric uchetkin.disk_used_percent "$DISK")" \
        "$(metric uchetkin.app_health "$APP")" \
        "$(metric uchetkin.containers_running "$RUNNING")" \
        "$(metric uchetkin.cert_days_left "$CERT_DAYS")")

      TOKEN=$(curl -sfH 'Metadata-Flavor: Google' "$META" | jq -re .access_token)
      curl -sf -X POST -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
        --data "$BODY" \
        "https://monitoring.api.cloud.yandex.net/monitoring/v2/data/write?folderId=$YC_FOLDER_ID&service=custom" \
        >/dev/null
      echo "копия $BACKUP_AGE ч, диск $DISK %, сертификат $CERT_DAYS дн., приложение $APP, контейнеров $RUNNING"

  - path: /etc/systemd/system/uchetkin-backup.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Резервная копия базы CRM «Учёткин» в Object Storage
      After=docker.service network-online.target
      Requires=docker.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/uchetkin-backup

  - path: /etc/systemd/system/uchetkin-backup.timer
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Ежедневная резервная копия базы CRM «Учёткин»

      [Timer]
      OnCalendar=${backup_schedule}
      RandomizedDelaySec=300
      Persistent=true

      [Install]
      WantedBy=timers.target

  - path: /etc/systemd/system/uchetkin-status.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Служебные метрики CRM «Учёткин» в Monitoring
      After=docker.service network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/uchetkin-status

  - path: /etc/systemd/system/uchetkin-status.timer
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Служебные метрики CRM «Учёткин» каждые ${status_interval_minutes} минут

      [Timer]
      OnBootSec=2min
      OnCalendar=*-*-* *:0/${status_interval_minutes}:00
      Persistent=true

      [Install]
      WantedBy=timers.target

  - path: /etc/uchetkin/README
    permissions: "0644"
    owner: root:root
    content: |
      Машина описана в Terraform: CRM_Poverka/infra. Руками её не настраивают —
      правка здесь потеряется при пересоздании ВМ.
        /etc/uchetkin/app.env            конфигурация приложения (без секретов)
        /opt/uchetkin/config/            конфигурация фронта
        /opt/uchetkin/compose.platform.yml  агент мониторинга (метрики + логи)
        /opt/uchetkin/compose.yml        приложение, кладёт выкладка (cloud-cicd)
        /usr/local/bin/uchetkin-backup   резервная копия базы → бакет ops (таймер, ночью)
        /usr/local/bin/uchetkin-status   служебные метрики → Monitoring (таймер, каждые 5 минут)
      Секреты лежат в Lockbox и читаются приложением при старте.
      Что значат оповещения и как восстанавливаться — CRM_Poverka/docs/ops.md.

runcmd:
  # Конфигурация SSH применяется сразу и только если она разбирается: сломанный
  # sshd на машине без пароля — это потеря доступа.
  - [sh, -c, "sshd -t && (systemctl restart ssh || systemctl restart sshd)"]
  - [mkdir, -p, /opt/uchetkin/config, /var/lib/yandex/unified_agent/main]
  - [chown, -R, "${vm_user}:${vm_user}", /opt/uchetkin]
  - [systemctl, enable, --now, docker]
  - [systemctl, restart, docker]
%{ if monitoring_agent_enabled ~}
  - [docker, compose, -f, /opt/uchetkin/compose.platform.yml, up, -d]
%{ endif ~}
  - [systemctl, enable, --now, unattended-upgrades]
  # Резервные копии и служебные метрики (пункт cloud-ops).
  - [mkdir, -p, /var/lib/uchetkin]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, uchetkin-backup.timer, uchetkin-status.timer]

final_message: "ВМ ${env} CRM «Учёткин» готова: docker и агент мониторинга подняты, конфигурация в /etc/uchetkin"
