# Контур разработки. Применён 18.09.2026 (см. README, раздел «Что применено»).
cloud_id  = "b1gq9bdjmkdml2pguse6"
folder_id = "b1giq117a18cpiolfife"

env = "dev"

# Зона — та, в которой уже стоит принятая в состояние машина. Зона ВМ и подсеть
# сменить нельзя: это пересоздание, а машина в облаке одна и она же боевая.
zone = "ru-central1-b"

# Временное имя: статический адрес контура (app_external_ip) через публичный
# сервис sslip.io — <адрес через дефисы>.sslip.io разрешается в этот адрес без
# чьих-либо DNS-записей, и Let's Encrypt выпускает на него сертификат. Проект
# независим от других продуктов подрядчика (решение владельца 18.09.2026):
# чужих доменов здесь нет. Боевой домен — пункт cloud-domain (порядок —
# docs/ops.md, «Переезд на боевой домен»): сюда — новое имя, tls_enabled = true,
# manage_dns_zone = true, mail_records_enabled = true, а в legacy_redirect_from —
# ["http://84.201.139.101"], чтобы закладки сотрудников вели на новый адрес.
app_domain = "84-201-139-101.sslip.io"

# Зоной DNS Terraform не управляет: имя выше разрешается само.
manage_dns_zone = false

# Контур работает по http и IP (пункт live-ip, docs/ops.md «Рабочий контур на
# временном адресе»). Включение HTTPS по имени выше — пункт live-tls, решение
# владельца: здесь true, повторный apply, из app.env на машине убрать
# SESSION_COOKIE_SECURE=false, из extra_cors_origins — http-адреса.
tls_enabled = false

# ─── Машина ──────────────────────────────────────────────────────────────────
# Контур принял уже существующую ВМ (создана руками 09.09.2026), поэтому
# параметры ниже описывают её как есть. Расходиться с фактом им нельзя:
# имя хоста, зона, образ и уменьшение диска — это пересоздание машины.
vm_name = "crm-uchetkin-prod"
vm_user = "alchemisttabia"

# Образ по идентификатору, а не последний в семействе: диск сделан из
# ubuntu-2404-lts-oslogin-v20260907, а в семействе уже лежит v20260914.
vm_image_id = "fd87qtsvhi9tt4req2uc"

vm_cores     = 2
vm_memory    = 4
vm_disk_size = 30
vm_disk_type = "network-ssd"
# Доля vCPU у машины — 100 %. Планировавшиеся для dev 20 % здесь не поставить:
# снижение доли у живой машины требует её остановки, а выигрыш — 130 ₽/мес.
vm_core_fraction = 100

# Снимков диска в dev нет: данных, которые нельзя потерять, здесь не держим.
vm_snapshot_schedule = false

# Машина создана с OS Login, вход ведёт облако: список пользователей и ключи
# живут в профилях IAM, а не в метаданных.
enable_oslogin = true

# Белый список для SSH пуст — правила 22/tcp в группе безопасности нет вовсе.
# Поэтому серийная консоль включена: это единственный оставшийся вход на машину,
# и он идёт через API облака, а не по сети.
ssh_allowed_cidrs  = []
ssh_public_keys    = []
serial_port_enable = true

# Базы как сервиса в dev нет: PostgreSQL контейнером на той же ВМ (arch, раздел 2).
managed_postgres = false

# ─── Хранилище ───────────────────────────────────────────────────────────────
# Имена бакетов глобальны на всё Object Storage, но uchetkin-dev-acts,
# uchetkin-dev-calls и uchetkin-dev-audit оказались свободны — проверено
# созданием 18.09.2026. Добавка к именам не нужна.
bucket_suffix = ""

# Пока контур открыт по http и IP: браузер с этих адресов кладёт кадры в
# бакет снимков (docs/uat.md, замечание 6а). Убрать вместе с tls_enabled = true.
extra_cors_origins = ["http://84.201.139.101", "http://127.0.0.1"]

# Сроки перехода в холодное хранение в dev укорочены — правило должно
# проверяться, а не ждать три месяца.
acts_cold_after_days  = 30
calls_cold_after_days = 30
calls_ice_after_days  = 90

# Безопасность (пункт cloud-sec, сводка — docs/security.md).
# Журнал аудита в dev живёт три месяца: правило должно проверяться,
# а хранить годами события тестового контура незачем.
audit_trail_enabled   = true
audit_retain_days     = 90
audit_cold_after_days = 15

# Ключ шифрования dev удаляется вместе с контуром — данных, которые нельзя
# потерять, здесь нет.
kms_deletion_protection = false

# Подсеть контура — принятая в состояние подсеть зоны b сети default.
subnet_cidr = "10.129.0.0/24"

labels = {
  contour = "dev"
}
