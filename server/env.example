# Скопировать в server/.env. Значения совпадают с docker-compose.yml.
DATABASE_URL=postgres://uchetkin:uchetkin@localhost:5432/uchetkin

# Префикс ключей фотографий в Object Storage. В базе хранится только ключ,
# домен бакета живёт в конфиге приложения — в данных доменов нет (архитектурное решение, п. 8).
PHOTO_KEY_PREFIX=acts
