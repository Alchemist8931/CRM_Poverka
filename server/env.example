# Скопировать в server/.env. Значения совпадают с docker-compose.yml.
DATABASE_URL=postgres://uchetkin:uchetkin@localhost:5432/uchetkin

# Хранилище снимков акта. Имена переменных те же, что пишет на ВМ cloud-init
# (infra/cloud-init.yaml.tftpl): на машине разработчика это MinIO, в облаке —
# Yandex Object Storage (S3_ENDPOINT=https://storage.yandexcloud.net), а ключ
# приходит из Lockbox по сервисному аккаунту ВМ (src/secrets.ts).
# Без этих четырёх значений хранилище считается неподключённым: загрузка
# отвечает 503, а выдача рисует заглушку с заводским номером прибора.
S3_ENDPOINT=http://localhost:9000
ACTS_BUCKET=uchetkin-acts
S3_ACCESS_KEY_ID=uchetkin
S3_SECRET_ACCESS_KEY=uchetkin-secret

# Регион и вид адреса. По умолчанию ru-central1 и путь endpoint/бакет/ключ —
# так работают и MinIO, и Object Storage.
# S3_REGION=ru-central1
# S3_FORCE_PATH_STYLE=true

# Префикс ключей настройкой не является: `acts/` для оригиналов и `thumbs/` для
# миниатюр зашиты в src/storage.ts, потому что по ним же написаны правила
# жизненного цикла бакета (infra/storage.tf). Разъехаться этим двум местам
# нельзя, а переменная окружения ровно это и позволила бы.
# В базе лежит только ключ: домена бакета в данных нет (arch, п. 8).

# ── Уведомления клиентам (int-notify) ───────────────────────────────────────
# Письма уходят с рабочего ящика конторы, а не с технического домена: своего
# домена у системы до пункта cloud-domain нет, а письмо с чужого имени без
# подписи отправляется в спам. При переезде на свой домен меняется NOTIFY_FROM
# и пароль ящика в Lockbox — больше нигде адрес отправителя не встречается.
NOTIFY_FROM=poverka.asbest@yandex.ru
NOTIFY_FROM_NAME=ИП Бердинских А. А.
# NOTIFY_REPLY_TO=poverka.asbest@yandex.ru
NOTIFY_SIGNATURE=С уважением, ИП Бердинских А. А. — поверка счётчиков, Асбест.
NOTIFY_OFFICE=ИП Бердинских
NOTIFY_OFFICE_PHONE=+7 (34365) 7-77-77

# Почта: ящик Яндекс 360 — это 465 и TLS сразу. Пароль — отдельный пароль
# приложения из настроек ящика, а не пароль входа, и в облаке он приходит из
# Lockbox (LOCKBOX_NOTIFY_SECRET_ID), а не из этой строки.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=poverka.asbest@yandex.ru
SMTP_PASSWORD=
# SMTP_SECURE=0   # только для локального приёмника в проверках

# СМС-шлюз: SMSC.ru (сравнение с SMS.RU и МТС Exolve — в docs/notify.md).
# SMS_TEST=1 — виртуальная отправка: шлюз отвечает как при настоящей, но
# абоненту ничего не уходит и деньги не списываются. Так работает тестовый
# контур до подписания договора с оператором.
SMS_LOGIN=
SMS_PASSWORD=
SMS_SENDER=
SMS_TEST=1

# Сколько раз пробовать и через сколько минут повторять. Пауза удваивается:
# 10, 20, 40, 80 минут.
# NOTIFY_MAX_ATTEMPTS=5
# NOTIFY_RETRY_MINUTES=10
# NOTIFY_TZ=Asia/Yekaterinburg
