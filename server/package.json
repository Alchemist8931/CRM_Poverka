{
  "name": "uchetkin-server",
  "version": "0.1.0",
  "private": true,
  "description": "CRM «Учёткин» — серверная часть: REST API с ролями, схема базы, миграции, наполнение демо-данными",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/api/server.ts",
    "dev": "tsx watch src/api/server.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down 1",
    "migrate:redo": "node-pg-migrate down 1 && node-pg-migrate up",
    "migrate:cloud": "tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "db:reset": "node-pg-migrate down 0 && node-pg-migrate up && tsx src/seed/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:model && npm run check:docs && npm run check:tables && npm run check:schema && npm run check:seed-cli && npm run check:import && npm run check:audit-prune && npm run check:arshin && npm run check:notify && npm run check:maps && npm run check:users",
    "check:model": "tsx scripts/check-model-sync.mts",
    "check:docs": "tsx scripts/check-docs.mts",
    "check:tables": "tsx scripts/check-tables.mts",
    "check:schema": "tsx scripts/check-schema.ts",
    "check:seed-cli": "tsx scripts/check-seed-cli.mts",
    "check:photos": "tsx scripts/check-photo-roundtrip.mts",
    "audit:prune": "tsx scripts/audit-prune.mts",
    "check:audit-prune": "tsx scripts/check-audit-prune.mts",
    "check:arshin": "tsx scripts/check-arshin.mts",
    "check:maps": "tsx scripts/check-maps.mts",
    "maps:prune": "tsx scripts/maps-prune.mts",
    "notify:tick": "tsx scripts/notify-worker.mts",
    "notify:probe": "tsx scripts/notify-probe.mts",
    "check:notify": "tsx scripts/check-notify.mts",
    "check:novofon-flow": "tsx scripts/check-novofon-flow.mts",
    "import": "tsx scripts/import/cli.mts",
    "check:import": "tsx scripts/check-import.mts",
    "init:accounts": "tsx scripts/init-accounts.mts",
    "check:users": "tsx scripts/check-users.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/swagger": "^9.8.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.4",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.8",
    "@electric-sql/pglite-socket": "^0.0.13",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "exceljs": "^4.4.0",
    "typescript": "^5.7.2",
    "xmllint-wasm": "^5.3.0"
  }
}
